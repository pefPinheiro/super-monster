{
  "name": "super-monster",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:mobile": "npm run dev --workspace=@super-monster/mobile",
    "build:mobile": "npm run build --workspace=@super-monster/mobile",
    "test:engine": "npm run test --workspace=@super-monster/game-engine",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
